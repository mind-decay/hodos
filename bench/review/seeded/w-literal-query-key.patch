+import { useQuery } from '@tanstack/react-query';
+
+import { listOrders } from '../api';
+
+export interface OrdersSummaryProps {
+  status: string;
+}
+
+export function OrdersSummary({ status }: OrdersSummaryProps) {
+  const orders = useQuery({
+    queryKey: ['orders', 'summary', status],
+    queryFn: () => listOrders(status),
+  });
+  if (!orders.data) return null;
+  const total = orders.data.reduce((sum, order) => sum + order.total, 0);
+  return (
+    <p aria-label="orders summary">
+      {orders.data.length} orders · {total.toFixed(2)}
+    </p>
+  );
+}
