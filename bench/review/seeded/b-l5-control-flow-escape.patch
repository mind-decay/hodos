+import { useState } from 'react';
+
+import { request } from '../../../lib/http';
+import type { Order } from '../api';
+
+/** Cancels the order the detail page is showing, and reports while it runs. */
+export function useCancelOrder(order: Order | undefined) {
+  const [busy, setBusy] = useState(false);
+
+  const cancel = async () => {
+    setBusy(true);
+    if (!order) return;
+    await request(`/orders/${order.id}/cancel`, { method: 'POST' });
+    setBusy(false);
+  };
+
+  return { busy, cancel };
+}
