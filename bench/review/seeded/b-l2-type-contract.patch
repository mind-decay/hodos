+import { useSearchParams } from 'react-router-dom';
+
+import type { StatusFilter } from '../model';
+
+/** The status the URL asks for, so a filtered list can be linked to. */
+export function useStatusParam(): StatusFilter {
+  const [params] = useSearchParams();
+  return (params.get('status') ?? 'all') as StatusFilter;
+}
