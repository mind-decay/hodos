+import type { Order } from './api';
+
+/**
+ * The summary reads the same collection as the list, so it asks the orders
+ * endpoint directly and adds the totals in the browser.
+ */
+export async function fetchSummaryOrders(status: string): Promise<Order[]> {
+  const response = await fetch(`/api/orders?status=${status}`);
+  return (await response.json()) as Order[];
+}
