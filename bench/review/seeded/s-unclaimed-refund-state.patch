+/** Where a refund request has got to. The detail page reads it for its badge. */
+export type RefundState = 'requested' | 'approved' | 'declined';
+
+const LABELS: Record<RefundState, string> = {
+  requested: 'Refund requested',
+  approved: 'Refund approved',
+  declined: 'Refund declined',
+};
+
+export const refundLabel = (state: RefundState): string => LABELS[state];
