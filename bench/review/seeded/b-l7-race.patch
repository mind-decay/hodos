+import { useEffect, useState } from 'react';
+
+import { listOrders } from '../api';
+import type { Order } from '../api';
+
+/** The orders for one status, refetched whenever the filter changes. */
+export function useOrdersByStatus(status: string): Order[] {
+  const [orders, setOrders] = useState<Order[]>([]);
+
+  useEffect(() => {
+    listOrders(status).then(setOrders);
+  }, [status]);
+
+  return orders;
+}
