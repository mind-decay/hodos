+# reports/orders.py
+def get_order_summaries(db, order_ids: list[int]) -> list[dict]:
+    """Return summary dicts with order id, customer name, and total."""
+    orders = db.query(
+        "SELECT id, customer_id, total FROM orders WHERE id = ANY(%s)",
+        (order_ids,)
+    )
+    summaries = []
+    for order in orders:
+        # Fetch the customer name for each order individually
+        customer = db.query_one(
+            "SELECT name FROM customers WHERE id = %s",
+            (order['customer_id'],)
+        )
+        summaries.append({
+            'order_id':      order['id'],
+            'customer_name': customer['name'],
+            'total':         order['total'],
+        })
+    return summaries
