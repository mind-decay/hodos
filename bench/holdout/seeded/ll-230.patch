+<?php
+// src/CsvParser.php
+
+function parseCsv(string $path): array {
+    $handle = fopen($path, 'r');
+    if ($handle === false) {
+        throw new \RuntimeException("Cannot open: $path");
+    }
+
+    $rows = [];
+    while (($cols = fgetcsv($handle)) !== false) {
+        if (count($cols) !== 3) {
+            throw new \InvalidArgumentException(
+                "Row must have 3 columns, got " . count($cols)
+            );
+            // file handle never closed
+        }
+        $rows[] = $cols;
+    }
+
+    fclose($handle);
+    return $rows;
+}
