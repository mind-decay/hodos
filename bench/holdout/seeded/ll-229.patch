+// tracking/RequestTracker.kt
+import kotlinx.coroutines.*
+
+class RequestTracker {
+    var activeRequests = 0   // plain Int, not AtomicInteger
+
+    suspend fun trackRequest(block: suspend () -> Unit) {
+        activeRequests++      // read-modify-write, NOT atomic
+        try {
+            block()
+        } finally {
+            activeRequests--  // also NOT atomic
+        }
+    }
+
+    fun isOverloaded(): Boolean = activeRequests > 100
+}
