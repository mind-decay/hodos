+public class Buffer {
+    private final Object lock = new Object();
+    private boolean ready = false;
+    private String payload;
+
+    public void produce(String p) {
+        synchronized (lock) {
+            payload = p;
+            ready = true;
+            lock.notify();
+        }
+    }
+
+    public String consume() throws InterruptedException {
+        synchronized (lock) {
+            if (!ready) {
+                lock.wait();
+            }
+            return payload;
+        }
+    }
