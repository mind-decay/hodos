+// store/state.go
+type Cache struct {
+    mu   sync.Mutex
+    data map[string]string
+}
+
+type Logger struct {
+    mu  sync.Mutex
+    buf []string
+}
+
+func (c *Cache) Write(logger *Logger, key, val string) {
+    c.mu.Lock()
+    defer c.mu.Unlock()
+    logger.mu.Lock()
+    defer logger.mu.Unlock()
+    c.data[key] = val
+    logger.buf = append(logger.buf, "wrote: "+key)
+}
+
+func (l *Logger) Flush(cache *Cache, summary string) {
+    l.mu.Lock()
+    defer l.mu.Unlock()
+    cache.mu.Lock()
+    defer cache.mu.Unlock()
+    cache.data["_flush"] = summary
+    l.buf = append(l.buf, "flushed")
+}
