+func fanOut(urls []string) {
+    var wg sync.WaitGroup
+    for _, u := range urls {
+        wg.Add(1)
+        go func() {
+            defer wg.Done()
+            resp, err := http.Get(u)
+            if err != nil {
+                log.Printf("fetch %s failed: %v", u, err)
+                return
+            }
+            resp.Body.Close()
+        }()
+    }
+    wg.Wait()
+}
