+# config/loader.py
+import json
+
+def load_config(path: str) -> dict:
+    with open(path, encoding='utf-8') as f:
+        return json.load(f)
+
+def load_all_configs(paths: list[str]) -> list[dict]:
+    return [load_config(p) for p in paths]
