+# utils/cache.py
+
+def append_to_cache(item, cache=None):
+    """Append item to cache list; creates a new list if cache not provided."""
+    if cache is None:
+        cache = []
+    cache.append(item)
+    return cache
+
+r1 = append_to_cache('a')
+r2 = append_to_cache('b')
+r3 = append_to_cache('c', r1)
+print(r1, r2, r3)
