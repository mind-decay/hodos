+// ui/buttons.js
+
+function createButtons(labels) {
+    const buttons = [];
+    for (let i = 0; i < labels.length; i++) {
+        buttons.push({
+            label: labels[i],
+            onClick: () => alert(`Clicked: ${labels[i]}`)
+        });
+    }
+    return buttons;
+}
+
+const btns = createButtons(['Home', 'About', 'Contact']);
+btns[0].onClick();  // Should alert 'Clicked: Home'
+btns[2].onClick();  // Should alert 'Clicked: Contact'
